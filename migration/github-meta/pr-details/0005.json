      "additions": 29,
      "blob_url": "https://github.com/ButaMonky/Hakushin067-Research-Knowledge/blob/f48ee7c0fd8ef9520dc959c2786c8273ce1815cb/research%2Fintake%2FE%2FE-PC-20261101-GOLDEN-G012-AND-KB-BACKLOG.md",
      "changes": 29,
